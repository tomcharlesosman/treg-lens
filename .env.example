# Required for key-based browser sign-in. Use a stable, private random value
# of at least 32 characters. Run npm run setup to generate .env.local safely.
# Setup preserves existing nonempty secrets and never prints their values.
SESSION_SECRET=

# Optional private writable directory for durable SQLite workspaces/schedules.
# Defaults to ./data. Keep it on persistent disk and back it up with its WAL.
# TREG_DATA_DIR=

# Optional public HTTPS origin, e.g. https://lens.example.com, used for absolute
# link-preview (Open Graph/X) image URLs. Set it before building on non-Vercel
# hosts; Vercel supplies its production domain automatically.
# SITE_URL=

# Optional server origin for the separate monitoring worker. Defaults to
# http://127.0.0.1:3000. Remote origins require HTTPS; redirects are refused.
# MONITOR_BASE_URL=

# Optional hosted database. Local forks need no cloud account: leave unset.
# On Vercel, connect Neon to populate DATABASE_URL automatically. Set a separate
# database for previews; run npm run db:migrate before starting a remote host.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# TREG_STORAGE=sqlite

# Optional Vercel Pro minutely dispatcher. Use an independent random secret.
# Neither variable authorizes a paid audit: each user still opts in and budgets.
# CRON_SECRET=
# TREG_VERCEL_MONITORING=1

# Users paste their own Treg team API key at /login.
# TREG_TOKEN and TREG_ORG are not required for browser sign-in or paid HTTP calls.
# Never commit .env.local or expose SESSION_SECRET through NEXT_PUBLIC_ variables.
