# Required for key-based browser sign-in. Use a stable, private random value
# of at least 32 characters. Generate one with: openssl rand -base64 48
# Copy the output after the equals sign below, in your private .env.local.
SESSION_SECRET=

# Users paste their own Treg team API key at /login.
# TREG_TOKEN and TREG_ORG are not required for browser sign-in or paid HTTP calls.
# Never commit .env.local or expose SESSION_SECRET through NEXT_PUBLIC_ variables.
