{
  "name": "treg-lens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run docs:check",
    "test": "tsx --test \"src/lib/*.test.ts\" \"scripts/*.test.mjs\"",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:report": "playwright show-report output/playwright/report"
  },
  "dependencies": {
    "iron-session": "^9.0.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "Open-source AI visibility workspace powered by the Treg AEO toolkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomcharlesosman/treg-lens.git"
  },
  "bugs": {
    "url": "https://github.com/tomcharlesosman/treg-lens/issues"
  },
  "homepage": "https://github.com/tomcharlesosman/treg-lens#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  }
}
